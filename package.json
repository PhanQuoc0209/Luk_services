{
  "name": "luk-services-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@luk/frontend",
    "dev:frontend": "npm run dev --workspace=@luk/frontend",
    "dev:backend": "npm run dev --workspace=@luk/backend",
    "build": "npm run build --workspace=@luk/frontend",
    "build:frontend": "npm run build --workspace=@luk/frontend",
    "build:backend": "npm run build --workspace=@luk/backend",
    "start": "npm run start --workspace=@luk/frontend",
    "start:frontend": "npm run start --workspace=@luk/frontend",
    "start:backend": "npm run start --workspace=@luk/backend",
    "test": "node --test backend/tests/*.test.mjs",
    "test:backend": "npm run test --workspace=@luk/backend",
    "lint": "npm run lint --workspace=@luk/frontend",
    "typecheck": "npm run typecheck --workspace=@luk/frontend",
    "db:push": "npx prisma db push --schema=backend/prisma/schema.prisma",
    "db:seed": "node backend/scripts/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@prisma/engines": "^5.22.0",
    "autoprefixer": "^10.5.2",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jose": "6.2.13",
    "lucide-react": "0.460.0",
    "next": "15.1.0",
    "postcss": "^8.4.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^3.4.19",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "20.19.41",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "prisma": "5.22.0",
    "typescript": "5.9.3"
  }
}
