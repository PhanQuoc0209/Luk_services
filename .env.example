# =========================================================================
# LUK Services Monorepo - Global Environment Variables (.env.example)
# Do NOT commit actual secrets or passwords to version control.
# Copy to frontend/.env and backend/.env for local development.
# =========================================================================

# Database Configuration (SQLite locally, PostgreSQL in Production)
DATABASE_URL="file:./prisma/dev.db"

# Authentication & Session Security (Minimum 32 characters in production)
JWT_SECRET="replace-with-a-secure-32-char-random-jwt-secret-in-production"
COOKIE_SECRET="replace-with-a-secure-cookie-secret-in-production"

# Default Admin Seed Account (Only used for npm run db:seed)
ADMIN_EMAIL="admin@lukglobal.vn"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_NAME="LUK Global Administrator"

# Private Storage Directory
STORAGE_DIR="./uploads/private"

# Email Configuration (Optional SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@lukglobal.vn"

# Bank & VietQR Configuration Defaults
DEFAULT_BANK_NAME="MB Bank (Ngân hàng Quân đội)"
DEFAULT_BANK_CODE="MB"
DEFAULT_ACCOUNT_NUMBER="0988888888"
DEFAULT_ACCOUNT_HOLDER="LUK SERVICES"
DEFAULT_BRANCH="Chi nhánh Hà Nội"
