# =========================================================================
# LUK Services - Backend Environment Variables (.env.example)
# Use this when deploying the Node.js / Express backend to Railway, Render,
# Fly.io, or a VPS.
# =========================================================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# Database URL (SQLite locally, PostgreSQL in Production)
DATABASE_URL="file:./prisma/dev.db"

# Authentication & Session Security (Minimum 32 characters in production)
JWT_SECRET="replace-with-a-secure-32-char-random-jwt-secret-in-production"
COOKIE_SECRET="replace-with-a-secure-cookie-secret-in-production"

# CORS Configuration (Comma-separated list of allowed frontend origins)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.vercel.app"

# Storage Directory for uploaded files
STORAGE_DIR="./uploads/private"

# Default Admin Seed Account (Only used for npm run db:seed)
ADMIN_EMAIL="admin@lukglobal.vn"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_NAME="LUK Global Administrator"
