# =========================================================================
# LUK Services - Frontend Environment Variables (.env.example)
# When deploying to Vercel with Root Directory "frontend", configure these
# in Project Settings > Environment Variables.
# =========================================================================

# Database URL for Next.js App Router (SQLite locally, PostgreSQL in Production)
DATABASE_URL="file:./prisma/dev.db"

# Authentication & Session Security (Minimum 32 characters in production)
JWT_SECRET="replace-with-a-secure-32-char-random-jwt-secret-in-production"
COOKIE_SECRET="replace-with-a-secure-cookie-secret-in-production"

# Backend API URL (Optional: Leave blank if using Next.js App Router API, or set to standalone Express backend URL)
# NEXT_PUBLIC_API_URL="http://localhost:5000"

# Storage Directory for uploaded documents & draft assets
STORAGE_DIR="./uploads/private"

# Email Configuration (Optional SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@lukglobal.vn"

# Bank & VietQR Defaults
DEFAULT_BANK_NAME="MB Bank (Ngân hàng Quân đội)"
DEFAULT_BANK_CODE="MB"
DEFAULT_ACCOUNT_NUMBER="0988888888"
DEFAULT_ACCOUNT_HOLDER="LUK SERVICES"
DEFAULT_BRANCH="Chi nhánh Hà Nội"
