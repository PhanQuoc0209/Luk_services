# =========================================================================
# LUK Services - Frontend Environment Variables (.env.example)
#
# When deploying to Vercel (Root Directory: "frontend"):
# Set these in: Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# =========================================================================

# 1. Database Connection String (REQUIRED in Production)
# - For Vercel Production (PostgreSQL, Neon, Supabase, Railway):
DATABASE_URL="postgresql://username:password@host:5432/database_name?sslmode=require"
# - For Local Development with SQLite:
# DATABASE_URL="file:./dev.db"
# Note: The build script automatically adapts Prisma provider to "postgresql" or "sqlite"!

# 2. Authentication & Session Security (REQUIRED in Production)
# Generate a random 32+ character key (e.g., run `openssl rand -base64 32`)
JWT_SECRET="replace-with-a-secure-32-char-random-jwt-secret-in-production"
COOKIE_SECRET="replace-with-a-secure-cookie-secret-in-production"

# 3. Application Domain URL
NEXT_PUBLIC_APP_URL="https://luk-services.vercel.app"

# 4. Standalone Backend API (Optional - leave blank if using Next.js App Router API)
# NEXT_PUBLIC_API_URL="https://your-backend-api.railway.app"

# 5. Storage Directory (Optional on Vercel - defaults to /tmp in Serverless Lambda)
# STORAGE_DIR="/tmp/luk-uploads/private"

# 6. Email Configuration (Optional SMTP - logs to console fallback when credentials not provided)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@lukglobal.vn"

# 7. Bank & VietQR Defaults (Configurable via Admin Console)
DEFAULT_BANK_NAME="MB Bank (Ngân hàng Quân đội)"
DEFAULT_BANK_CODE="MB"
DEFAULT_ACCOUNT_NUMBER="0988888888"
DEFAULT_ACCOUNT_HOLDER="LUK SERVICES"
DEFAULT_BRANCH="Chi nhánh Hà Nội"
